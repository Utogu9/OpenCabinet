{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenCabinet",
  "version": "0.1.0",
  "identifier": "opencabinet",
  "build": {
    "beforeDevCommand": {
      "script": "npm run prepare:locales && npm run prepare:pdf",
      "wait": true
    },
    "beforeBuildCommand": "npm run prepare:locales && npm run prepare:pdf",
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "OpenCabinet",
        "decorations": false,
        "maximized": true,
        "visible": false,
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": []
      },
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "publisher": "Utogu",
    "copyright": "Copyright (c) 2026 Utogu",
    "shortDescription": "OpenCabinet game library and launcher",
    "longDescription": "Organize and launch your games, configure emulators, and explore interactive 3D game boxes and PDF manuals.",
    "resources": {
      "../LICENSE": "LICENSE",
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md"
    },
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "requireSignedVersion": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg4MTg2NzExOURBRThBQTkKUldTcGlxNmRFV2NZaUMrWituRE1yUVVJSTZwc2tPQWVrRFRJejk5T3BHSUU2b1pRUGVFL0dGZTQK",
      "endpoints": [
        "https://github.com/Utogu9/OpenCabinet/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
